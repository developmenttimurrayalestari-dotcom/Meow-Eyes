# Development: FastAPI on port 8001. Use an empty value behind a same-origin production reverse proxy.
REACT_APP_BACKEND_URL=http://localhost:8001

# Public widget key from ConveyThis > Domains > meoweyes.com > Install (JavaScript).
# Source language: Indonesian (id); translated language: English (en).
# Rebuild the frontend after changing this value. This is not a backend secret.
REACT_APP_CONVEYTHIS_API_KEY=
