# Copy to backend/.env.mysql. This file does not configure the MongoDB server.
# Target: MySQL 5.7.24-log (5.7 patch >=24); the driver recognizes the -log suffix.
# Set host/port to your EXISTING server. This file does not change its version.
# Compose instead starts a separate mysql:5.7.24 development instance/volume.
# Fill both passwords locally; use different strong values. Never commit them.
# Environment variables take precedence over this file.
# Use SINGLE-QUOTED passwords for special characters ($, #, spaces), so Compose
# preserves them too. Python disables interpolation; Compose has its own parser.
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=meow_eyes

# Compose creates this schema-scoped LOCAL DEVELOPMENT migration account.
# For production, use a separate runtime account without DDL privileges.
# The migration account also needs permission to create validation triggers.
MYSQL_USER=meow_migrator
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT_SECONDS=30
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_HEALTH_TIMEOUT_SECONDS=5

# Local Compose uses loopback without TLS. Production requires verify_identity.
# An omitted CA uses the OS trust store. Relative file paths are based on this file.
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

# Production example (supply your own host, runtime user, and credentials):
# APP_ENV=production
# MYSQL_SSL_MODE=verify_identity
# MYSQL_SSL_CA=certificates/mysql-ca.pem

# Existing MySQL 5.7 server prerequisites for utf8mb4 relational indexes:
# innodb_large_prefix=ON and innodb_page_size >=16384. Migrations explicitly
# create InnoDB DYNAMIC tables. No existing server globals are changed.
# Compose prefers Barracuda and file_per_table=ON; these are not hard runtime
# requirements when DYNAMIC is explicit. Server settings belong to your DBA.

# Step 2 application configuration (server:app).
# Browser origins must be explicit, comma-separated. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Run scheduled jobs on one designated worker; leave disabled on other workers.
SCHEDULER_ENABLED=1
# Simulated checkout/payment is disabled by default and always rejected in
# production. To exercise offline fixtures locally, set ENABLE_MOCK_PAYMENTS=1,
# PAYMENT_PROVIDER=mock and SHIPPING_PROVIDER=mock together.
ENABLE_MOCK_PAYMENTS=0

# Step 8–9: real provider adapters. Secrets stay on the backend, never in REACT_APP_*.
# Credentials are intentionally blank: an unconfigured provider fails closed.
PAYMENT_PROVIDER=doku
SHIPPING_PROVIDER=everpro
PUBLIC_FRONTEND_URL=http://localhost:3000
# Public HTTPS origin of the backend, without /api. Optional for local work.
# When set, DOKU's override_notification_url is derived from this + the path.
PUBLIC_API_URL=

# DOKU hosted Checkout, non-SNAP HMAC protocol (no card entry on this app).
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PAYMENT_DUE_MINUTES=60
# This is the external path signed by DOKU. Configure the same Notification URL
# in the merchant dashboard. If a proxy rewrites paths, this is the PUBLIC path;
# the internal route remains POST /api/webhooks/doku.
DOKU_NOTIFICATION_PATH=/api/webhooks/doku
# Allow legitimate provider retries while event IDs reject duplicate effects.
DOKU_WEBHOOK_MAX_AGE_SECONDS=172800

# Everpro Open API. The documented sandbox host is below. Obtain the exact
# production host from Everpro onboarding; no production host is guessed.
EVERPRO_ENVIRONMENT=sandbox
EVERPRO_BASE_URL=https://client-api-sandbox.everpro.id
EVERPRO_CLIENT_KEY=
EVERPRO_CLIENT_SECRET=
# Shared x-everpro-key from onboarding, NOT the token or client secret.
EVERPRO_WEBHOOK_KEY=
EVERPRO_ORIGIN_POSTAL_CODE=
# Kelurahan/desa, not Kecamatan.
EVERPRO_ORIGIN_SUBDISTRICT=
EVERPRO_SHIPPER_NAME=
EVERPRO_SHIPPER_PHONE=
EVERPRO_SHIPPER_ADDRESS=
EVERPRO_SHIPPER_EMAIL=
# DROP: staff drops at a carrier counter. PICKUP: admin must select a provider
# pickup window when booking. Paying does not dispatch unprepared optical goods.
EVERPRO_SHIPMENT_TYPE=DROP
EVERPRO_PACKAGE_TYPE_ID=3
# Actual packed dimensions must match these operator-supplied values.
EVERPRO_PACKAGE_LENGTH_CM=20
EVERPRO_PACKAGE_WIDTH_CM=12
EVERPRO_PACKAGE_HEIGHT_CM=8
EVERPRO_USE_INSURANCE=0
EVERPRO_QUOTE_TTL_SECONDS=600

# Prescription photos: keep outside any public/static server mount.
# Use a persistent directory readable only by the backend service.
PRIVATE_UPLOAD_ROOT=./private_uploads
